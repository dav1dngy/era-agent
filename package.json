{
  "name": "era-agent",
  "version": "0.2.0-dev.1",
  "description": "ERA is an AI-powered reverse-engineering agent that analyzes software, verifies its findings, and evolves its own implementation through controlled recursive self-improvement.",
  "type": "module",
  "bin": {
    "era": "bin/era.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "era.config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "check": "node scripts/check.mjs",
    "clean-install-test": "bash scripts/clean-install-test.sh",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "rea-agents": "6.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dav1dngy/era-agent.git"
  },
  "keywords": [
    "reverse-engineering",
    "agent",
    "rea",
    "self-improvement",
    "mach-o",
    "javascript"
  ],
  "author": "dav1dngy",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
