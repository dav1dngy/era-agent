# Optional environment overrides for ERA. Copy to .env and export as needed.
# ERA never reads secrets; no API keys are required.

# Absolute path to a specific REA CLI (otherwise node_modules/.bin/rea, then PATH).
# ERA_REA_BIN=/usr/local/bin/rea

# Where ERA keeps runs, analyses, cycles and the ledger (default: ./.era).
# ERA_STATE_DIR=/path/to/state

# REA provider configuration (read by REA, not by ERA):
# GHIDRA_INSTALL_DIR=/opt/ghidra_12.1
# REA_IDA_MCP_CONFIG=/path/to/ida-mcp.json
