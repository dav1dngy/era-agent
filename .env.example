# Optional environment overrides for ERA. Copy to .env and export the ones you need (ERA does not load .env files by itself).
# ERA never reads or stores provider credentials; no API keys are required. Each coding-agent CLI keeps its own sign-in.

# --- ERA ---
# Absolute path to a specific REA CLI (otherwise node_modules/.bin/rea, then PATH).
# ERA_REA_BIN=/usr/local/bin/rea
# Where ERA keeps runs, analyses, cycles, projects and the ledger (default: ./.era).
# ERA_STATE_DIR=/path/to/state
# Structured logs in <state>/logs: debug | info (default) | warn | error; ERA_LOG=off disables them.
# ERA_LOG_LEVEL=info
# ERA_LOG=off
# Run agents that report no dollar cost (for example Codex) without a dollar spending cap. Off by default; enable only deliberately.
# ERA_ALLOW_UNMETERED_AGENTS=1

# --- ERA Studio ---
# Working directory and state for the desktop app when it is not started from a checkout.
# ERA_STUDIO_CWD=/path/to/workspace
# Allow the browser developer tools in the desktop app.
# ERA_STUDIO_DEVTOOLS=1
# Renderer used for the visual comparison of screenshot rebuilds (an Electron app or binary); ERA_RENDERER_DISABLE=1 turns the comparison off.
# ERA_RENDERER_BIN=/path/to/electron
# ERA_RENDERER_APP=/path/to/app
# ERA_RENDERER_DISABLE=1

# --- Native decompilation (read by REA, not by ERA) ---
# Ghidra needs a JDK 21 on PATH and its install directory:
# GHIDRA_INSTALL_DIR=/opt/ghidra
# REA_IDA_MCP_CONFIG=/path/to/ida-mcp.json
