index 0000000..73e383a
--- /dev/null
+++ b/tests/control-plane-jobs.test.js
@@ -0,0 +1,116 @@
+// Studio backend: the job manager that supervises ERA CLI commands as child processes.
+// REAL   JobManager, real child processes (node -e scripts), real state files.
+// FAKE   the event bus and audit log (recorders), settings.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { JobManager } from '../src/control_plane/jobs.js';
+import { tempDir } from './helpers.js';
+
+function manager({ concurrentJobs = 2, dir = tempDir('era-jobs-') } = {}) {
+  const events = [];
+  const audit = [];
+  const jm = new JobManager({
+    config: { stateDirAbs: dir, cwd: dir },
+    bus: { publish: (type, data) => events.push({ type, data }) },
+    audit: { record: (type, data) => audit.push({ type, data }) },
+    getSettings: () => ({ privacy: { logRetentionDays: 30 }, execution: { concurrentJobs } }),
+  });
+  return { jm, events, audit, dir };
+}
+const node = (script) => ({ command: process.execPath, args: ['-e', script] });
+const spec = (script, extra = {}) => ({ kind: 'test', label: 'test job', exec: node(script), ...extra });
+async function until(fn, ms = 10_000) {
+  const end = Date.now() + ms;
+  while (!fn()) {
+    if (Date.now() > end) throw new Error('timed out waiting for condition');
+    await new Promise((r) => setTimeout(r, 20));
+  }
+}
+const finished = (jm, id) => ['succeeded', 'failed', 'cancelled', 'interrupted'].includes(jm.get(id).status);
+
+test('a job runs, records its trailing JSON result, log tail and a durable record', async () => {
+  const { jm, events, audit } = manager();
+  const j = jm.start(spec('console.log("progress text"); console.log(JSON.stringify({ ok: true, n: 3 }))'));
+  await until(() => finished(jm, j.id));
+  const job = jm.get(j.id);
+  assert.equal(job.status, 'succeeded');
+  assert.equal(job.exit_code, 0);
+  assert.deepEqual(job.result, { ok: true, n: 3 });
+  assert.ok(job.log_tail.includes('progress text'));
+  assert.ok(existsSync(join(jm.dir, `${j.id}.json`)));
+  assert.deepEqual(audit.map((a) => a.type), ['job.queued', 'job.finished']);
+  assert.ok(events.some((e) => e.type === 'job.updated'));
+  assert.ok(events.some((e) => e.type === 'job.log'));
+  assert.equal('log_tail' in jm.list()[0], false, 'summaries leave the log tail out');
+});
+
+test('failures keep stderr as the error and secrets never reach the log', async () => {
+  const { jm } = manager();
+  const j = jm.start(spec('console.error("token sk-ant-api03-' + 'a'.repeat(40) + ' rejected"); process.exit(4)'));
+  await until(() => finished(jm, j.id));
+  const job = jm.get(j.id);
+  assert.equal(job.status, 'failed');
+  assert.equal(job.exit_code, 4);
+  assert.ok(job.error.length > 0);
+  assert.equal(JSON.stringify(job).includes('a'.repeat(40)), false, 'the API key is redacted');
+});
+
+test('concurrency limit queues extra jobs and a project allows one active job', async () => {
+  const { jm } = manager({ concurrentJobs: 1 });
+  const a = jm.start(spec('setTimeout(() => {}, 400)', { project_id: 'p1' }));
+  const b = jm.start(spec('0'));
+  assert.equal(jm.get(a.id).status, 'running');
+  assert.equal(jm.get(b.id).status, 'queued');
+  assert.throws(() => jm.start(spec('0', { project_id: 'p1' })), (e) => e.status === 409);
+  await until(() => finished(jm, a.id) && finished(jm, b.id));
+  assert.equal(jm.get(b.id).status, 'succeeded');
+});
+
+test('cancel stops a queued job without starting it and a running job as cancelled', async () => {
+  const { jm } = manager({ concurrentJobs: 1 });
+  const run = jm.start(spec('setInterval(() => {}, 1000)'));
+  const queued = jm.start(spec('0'));
+  assert.equal((await jm.cancel(queued.id)).status, 'cancelled');
+  assert.equal(jm.get(queued.id).started_at, null);
+  await until(() => jm.get(run.id).pid);
+  await jm.cancel(run.id);
+  await until(() => finished(jm, run.id));
+  assert.equal(jm.get(run.id).status, 'cancelled');
+  assert.equal(await jm.cancel('job-missing'), null);
+});
+
+test('a restarted manager marks jobs it no longer owns as interrupted', () => {
+  const { jm, dir } = manager();
+  writeFileSync(join(jm.dir, 'job-orphan.json'), JSON.stringify({ id: 'job-orphan', kind: 'test', status: 'running', created_at: new Date().toISOString(), started_at: new Date().toISOString(), finished_at: null, log_tail: [] }));
+  const again = manager({ dir }).jm;
+  const job = again.get('job-orphan');
+  assert.equal(job.status, 'interrupted');
+  assert.match(job.error, /restarted/);
+  assert.equal(JSON.parse(readFileSync(join(again.dir, 'job-orphan.json'), 'utf8')).status, 'interrupted');
+  assert.ok(readdirSync(again.dir).length >= 1);
+});
+
+test('shutdown returns as soon as the jobs have exited instead of waiting out the grace period', async () => {
+  const { jm } = manager();
+  const j = jm.start(spec('setInterval(() => {}, 1000)'));
+  await until(() => jm.get(j.id).pid);
+  const t0 = Date.now();
+  await jm.shutdown();
+  const elapsed = Date.now() - t0;
+  assert.ok(elapsed < 1000, `a cooperative job should stop well inside the 1.5 s grace period (took ${elapsed} ms)`);
+  assert.equal(jm.get(j.id).status, 'interrupted');
+  assert.throws(() => jm.start(spec('0')), /shutting down/);
+});
+
+test('shutdown escalates to SIGKILL for a job that ignores SIGTERM', async () => {
+  const { jm } = manager();
+  const j = jm.start(spec('process.on("SIGTERM", () => {}); setInterval(() => {}, 1000)'));
+  await until(() => jm.get(j.id).pid);
+  await new Promise((r) => setTimeout(r, 300)); // let the handler install
+  await jm.shutdown();
+  await until(() => finished(jm, j.id));
+  assert.equal(jm.get(j.id).status, 'interrupted');
+  assert.match(jm.get(j.id).error, /closed/);
+});
