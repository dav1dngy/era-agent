+++ b/tests/search.test.js
@@ -0,0 +1,36 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { list, search } = require('../src/catalog.js');
+
+test('search matches names case-insensitively in catalog order', () => {
+  assert.deepEqual(search('mUg').map((product) => product.id), [1, 2]);
+});
+
+test('search matches tags case-insensitively, including partial tags', () => {
+  assert.deepEqual(search('OFFICE').map((product) => product.id), [3]);
+  assert.deepEqual(search('KiT').map((product) => product.id), [1, 2]);
+  assert.deepEqual(search('CERAMIC').map((product) => product.id), [1]);
+});
+
+test('search returns no products for unmatched or literal special characters', () => {
+  assert.deepEqual(search('zzz'), []);
+  assert.deepEqual(search('.*'), []);
+});
+
+test('search with an empty query returns every product in catalog order', () => {
+  assert.deepEqual(search(''), list());
+});
+
+test('search returns each product once when multiple fields match', () => {
+  assert.deepEqual(search('e').map((product) => product.id), [1, 2, 3]);
+});
+
+test('search returns shallow copies without changing the catalog', () => {
+  const result = search('red');
+  const original = list()[0];
+  assert.notStrictEqual(result[0], original);
+  assert.strictEqual(result[0].tags, original.tags);
+  result[0].name = 'changed';
+  assert.equal(list()[0].name, 'Red Mug');
+  assert.equal(search('red')[0].name, 'Red Mug');
+});
